# Open Router API key (server-side only). Get one at https://openrouter.ai
OPENROUTER_API_KEY=

# ─── Batch runner (`npm run eval`) ────────────────────────────────────────────────────────────────
# Copy this file to `.env` (git-ignored) and fill in only the providers your run's config uses: a model
# whose key is missing is recorded as failed, with the key's name, and sends nothing. `npm run eval` reads
# `.env` itself.

# Anthropic (Claude Opus 5.5, Haiku 5.5; Message Batches for judges marked `batch`).
ANTHROPIC_API_KEY=

# Azure AI Foundry (GPT-6 Astra, GPT-6.1 Sol, GPT-6 Luna, DeepSeek V4.1 Flash). Both are needed. The base URL
# is the resource's OpenAI-compatible v1 root: https://<resource>.cognitiveservices.azure.com/openai/v1
AZURE_BASE_URL=
AZURE_API_KEY=

# Google Gemini API (Gemini 4 Argon, 3.8 Flash, 3 Flash preview).
GEMINI_API_KEY=

# Meta Model API (Muse Wonder).
META_MODEL_API_KEY=

# Inception (Mercury 3).
INCEPTION_API_KEY=

# DeepSeek (DeepSeek V4.1 Flash, direct).
DEEPSEEK_API_KEY=
